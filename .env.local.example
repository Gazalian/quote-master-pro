# ============================================================================
# OtoQuote AI — Frontend env vars (Vite — PREFIXED VITE_ ARE SHIPPED TO BROWSER)
# ============================================================================
# Copy to `.env.local` and fill in your values. Never commit real values.
#
# IMPORTANT: Anything with VITE_ prefix is BUNDLED INTO THE BROWSER JAVASCRIPT.
# Treat as public. NEVER put service-role keys, API secrets, or AI provider
# keys here. AI keys live in the backend (see backend/.env.example).
# ============================================================================

# Supabase (publishable — safe to ship)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (your Fastify deployment)
VITE_API_BASE_URL=http://localhost:3001
