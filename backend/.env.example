# ============================================================================
# OtoQuote AI — Backend env vars (server-only, NEVER ship to browser)
# ============================================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is used only for trusted server-side calls (RPC dispatch).
# This MUST stay server-side. Treat like a database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI providers ─────────────────────────────────────────────────────────────
# Provider chain. PRIMARY is tried first; FALLBACK runs on provider/API
# failure (timeout, 429, 5xx, bad model/key, malformed JSON, network issue).
#
# To swap Gemini back to primary later:
#   AI_PROVIDER_PRIMARY=gemini
#   AI_PROVIDER_FALLBACK=openai
# No code changes required.
AI_PROVIDER_PRIMARY=openai
AI_PROVIDER_FALLBACK=gemini

# OpenAI — server-only secret.  Required if openai is in the provider chain.
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_REQUEST_TIMEOUT_MS=45000

# Google Gemini — server-only secret.  Required if gemini is in the chain.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_REQUEST_TIMEOUT_MS=45000

# Rate limiting (per user per minute)
RATE_LIMIT_QUOTE_GEN_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# ── Monetization toggles (default OFF = fully free tier) ────────────────────
# Flip any flag to `true` and set its matching cost to re-enable that gate.
# DB function `save_quote_with_points` already no-ops when the cost is 0, so
# toggling these is safe with no migration.
BILLING_ENABLED=false
POINTS_ENABLED=false
PREMIUM_ENABLED=false
USAGE_LIMITS_ENABLED=false

# Per-action point costs. Honoured only when POINTS_ENABLED=true.
QUOTE_GENERATION_POINTS_COST=0
PDF_EXPORT_POINTS_COST=0
