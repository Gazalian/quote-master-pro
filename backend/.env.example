# ============================================================================
# OtoQuote AI — Backend env vars (server-only, NEVER ship to browser)
# ============================================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is used only for trusted server-side calls (RPC dispatch).
# This MUST stay server-side. Treat like a database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — server-only secret
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_REQUEST_TIMEOUT_MS=45000

# Rate limiting (per user per minute)
RATE_LIMIT_QUOTE_GEN_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# Quote economics
QUOTE_GENERATION_POINTS_COST=3
PDF_EXPORT_POINTS_COST=2
